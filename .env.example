# --- Required in production -------------------------------------------------
# Random string, 32+ chars  (openssl rand -base64 48)
AUTH_SECRET=
# Postgres connection string (Neon, Supabase, RDS…). Migrations run on boot.
# Leave empty locally to use embedded Postgres (PGlite) stored in ./data/pglite.
DATABASE_URL=
# Public origin, used for canonical URLs, emails, sitemap and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Billing (Paystack) ------------------------------------------------------
# Without a secret key, development uses a simulated checkout.
PAYSTACK_SECRET_KEY=
# Create these four plans in the Paystack dashboard (amounts must match lib/plans.ts), then paste the codes:
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=
PAYSTACK_PLAN_BUSINESS_MONTHLY=
PAYSTACK_PLAN_BUSINESS_YEARLY=
# Webhook URL to register in Paystack: https://<your-domain>/api/webhooks/paystack

# --- Email (Resend). Without a key, emails are printed to the server console in dev.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend
MAIL_FROM="StageGrid <no-reply@yourdomain.com>"
MAIL_REPLY_TO=
# Protects GET /api/cron/reminders (call it hourly with "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Seed sample orgs/events + a demo account on an empty database (always on in development)
SEED_DEMO=false
# Set to "false" to run `npm run db:migrate` yourself instead of migrating on boot
AUTO_MIGRATE=true
NEXT_PUBLIC_POSTHOG_KEY=
